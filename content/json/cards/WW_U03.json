          "sprite": "@WW_U03CardArt"
        }
      }
    },
    {
      "id": "WW_U03CharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@WW_U03CharacterArt",
          "transform": {
