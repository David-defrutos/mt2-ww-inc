        "german": "Professor für feindselige Medizin",
        "portuguese": "Professor de Medicina Hostil",
        "russian": "Профессор враждебной медицины",
        "chinese": "敌意医学教授",
        "chinese_traditional": "敵意醫學教授",
        "korean": "적대 의학 교수",
        "japanese": "敵対医学教授"
      },
      "character_art": "@WW_U03CharacterArt",
      "size": 2,
      "health": 25,
      "attack_damage": 10,
      "subtypes": [
        "@WW_Wizard",
        "SubtypesData_BannerUnit"
      ],
      "triggers": [
        "@WW_U03_Overheal"
      ]
    }
