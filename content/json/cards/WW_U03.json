{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "effects": [
    {
      "id": "WW_U03_Spawn",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "target_team": "monsters",
      "param_character": "@WW_U03_Character"
    },
    {
      "id": "WW_U03_OverhealEffect",
      "name": "@CardEffectOverhealDamage",
      "target_mode": "room",
      "target_team": "heroes",
      "param_int": 1
    }
  ],
  "cards": [
