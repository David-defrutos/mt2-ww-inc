  "cards": [
    {
      "id": "WW_U10_Ability",
      "names": {
        "english": "Credit Conversion",
        "spanish": "Conversión de Créditos",
        "french": "Conversion de crédits",
        "german": "Leistungspunkteumwandlung",
        "portuguese": "Conversão de Créditos",
        "russian": "Обмен зачётных единиц",
        "chinese": "学分转换",
        "chinese_traditional": "學分轉換",
        "korean": "학점 전환",
        "japanese": "単位変換"
      },
      "descriptions": {
        "spanish": "[consume] un hechizo de tu mano sin jugarlo. Añade [conduit] igual a 5 veces su coste base.",
        "french": "[consume] un sort en main sans le jouer. Gagnez [conduit] égal à 5 fois son coût de base.",
        "german": "[consume] einen Zauber auf der Hand, ohne ihn zu spielen. Erhalte [conduit] in Höhe des 5-Fachen seiner Grundkosten.",
        "portuguese": "[consume] um feitiço na mão sem jogá-lo. Ganha [conduit] igual a 5 vezes seu custo base.",
        "russian": "Примените [consume] к заклинанию в руке, не разыгрывая его. Получите [conduit] в размере 5 его базовых стоимостей.",
        "chinese": "不打出一张手牌法术，而是将其[consume]。获得其基础费用5倍的[conduit]。",
        "chinese_traditional": "不打出一張手牌法術，而是將其[consume]。獲得其基礎費用5倍的[conduit]。",
        "korean": "손의 주문 하나를 사용하지 않고 [consume]합니다. 기본 비용의 5배만큼 [conduit]를 얻습니다.",
        "japanese": "手札の呪文1枚をプレイせず[consume]する。基本コストの5倍の[conduit]を得る。",
        "english": "[consume] a spell in hand without playing it. Gain [conduit] equal to 5 times its base cost."
      },
      "card_type": "spell",
      "cost": 0,
      "rarity": "starter",
      "class": "@WW_Class",
      "is_an_ability": true,
      "targetless": true,
      "targets_room": false,
      "cooldown": 2,
      "hide_in_logbook": true,
      "ignore_when_counting_mastery": true,
      "card_art": "@WW_U10CardArt",
      "effects": [
        "@WW_U10_Ability_Effect"
      ],
      "initial_keyboard_target": "front_friendly"
    },
    {
      "id": "WW_U10",
